{
  "name": "engcoach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:arch": "depcruise --config .dependency-cruiser.cjs lib components app server prompts db",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:arch",
    "eval:analyzers": "tsx tests/evals/runAnalyzerEval.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx db/push.ts",
    "db:seed": "tsx db/seed/index.ts",
    "db:reset": "tsx db/reset.ts",
    "job:purge": "tsx server/jobs/runPurge.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@electric-sql/pglite": "^0.2.17",
    "@ricky0123/vad-web": "^0.0.24",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "next": "^15.5.4",
    "onnxruntime-web": "^1.22.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.0.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
